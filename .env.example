# Gere cada segredo separadamente com openssl rand -hex 32.
POSTGRES_PASSWORD=
APP_SECRET=
ADMIN_SETUP_TOKEN=

# Use http://localhost:3000 no Compose local e a URL HTTPS exata no Dokploy.
ORIGIN=http://localhost:3000

# No Dokploy, defina ADDRESS_HEADER=x-forwarded-for para usar o IP do cliente via Traefik.
ADDRESS_HEADER=
XFF_DEPTH=1
