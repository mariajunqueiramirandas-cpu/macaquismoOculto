{
  "name": "macaquismo-oculto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "svelte-kit sync && vite build",
    "start": "node build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lucide/svelte": "^1.80.0",
    "@opentelemetry/api": "^1.0.0",
    "@sveltejs/adapter-node": "^6.0.6",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
